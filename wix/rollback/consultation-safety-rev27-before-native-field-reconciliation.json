  "embedData": {
    "category": "ESSENTIAL",
    "html": "<div id=\"bb-email-safety-banner\" style=\"display:none;box-sizing:border-box;width:calc(100% - 28px);max-width:1120px;margin:18px auto 26px;padding:28px;border:1.5px solid #b59a62;border-radius:20px;background:linear-gradient(135deg,#ffffff,#f4f2ec);color:#15171a;box-shadow:0 14px 36px rgba(0,0,0,.10);font-family:Arial,Helvetica,sans-serif;position:relative;z-index:2147483000\">\n  <div style=\"font-size:13px;font-weight:800;letter-spacing:.11em;text-transform:uppercase;color:#775f2f;margin-bottom:8px\">Temporary consultation notice</div>\n  <div style=\"font-size:25px;font-weight:800;line-height:1.18;margin-bottom:10px\">Prefer email? You can contact Ryan directly.</div>\n  <div style=\"font-size:15px;line-height:1.58;max-width:930px\">Complete the consultation form above. When you press the request button, your email app will open with the information prepared. Press Send in your email app to complete your request, or use the direct email option below.</div>\n  <a href=\"mailto:Ryan_Carvalho@BehavioralBridge.org?subject=Behavioral%20Bridge%20Consultation%20Request&body=Hi%20Ryan%2C%0A%0AI%20am%20reaching%20out%20through%20the%20Behavioral%20Bridge%20website.%0A%0A\" style=\"box-sizing:border-box;display:block;width:100%;margin-top:19px;padding:21px 24px;border:1px solid #b59a62;border-radius:14px;background:#111316;color:#ffffff;text-decoration:none;text-align:center;font-size:21px;font-weight:800;letter-spacing:.035em;box-shadow:0 9px 22px rgba(0,0,0,.16)\">EMAIL RYAN DIRECTLY →</a>\n  <div style=\"margin-top:11px;text-align:center;font-size:13px;color:#555b61\">Ryan_Carvalho@BehavioralBridge.org · If your email app does not open, copy this address into a new message.</div>\n</div>\n<script>(function(){\n  if(window.__BB_EMAIL_ONLY_V8__) return; window.__BB_EMAIL_ONLY_V8__=true;\n  function bbIsConsult(){var p=location.pathname.replace(/\\/$/,\"\");return p===\"/book-consultation\"||p===\"/consultation\"}\n  function bbSyncBanner(){var z=document.getElementById(\"bb-email-safety-banner\");if(z)z.style.display=bbIsConsult()?\"block\":\"none\"}\n  function controls(r){return Array.from((r||document).querySelectorAll('input,textarea,select')).filter(function(x){return !['hidden','submit','button'].includes(x.type)})}\n  function root(){var em=Array.from(document.querySelectorAll('input[type=email],input[name*=email i],input[id*=email i]')).find(function(x){return x.offsetParent!==null}); if(!em)return null; var n=em; for(var i=0;n&&i<20;i++,n=n.parentElement){if(controls(n).length>=3 && n.querySelector('button,input[type=submit]')) return n} return em.closest('form')}\n  function val(x){return x?(x.value||'').trim():''}\n  function dsc(x){return [x&&x.name,x&&x.id,x&&x.placeholder,x&&x.getAttribute&&x.getAttribute('aria-label')].filter(Boolean).join(' ').toLowerCase()}\n  function pick(a,re){var h=a.find(function(x){return val(x)&&re.test(dsc(x))});return h?val(h):''}\n  function buildMail(r){var a=controls(r),email=pick(a,/email/),phone=pick(a,/phone|mobile|tel/),student=pick(a,/student.*name|name.*student/),grade=pick(a,/grade|year in school/),first=pick(a,/first.*name|name.*first/),last=pick(a,/last.*name|name.*last/),service=pick(a,/service/);a.filter(function(x){return x.tagName==='SELECT'&&val(x)}).forEach(function(x){if(!service&&!/grade|year/.test(dsc(x)))service=val(x)});var areas=a.filter(function(x){return x.tagName==='TEXTAREA'&&val(x)}),goals=areas[0]?val(areas[0]):pick(a,/goal|challenge|help|message|looking for/),availability=areas[1]?val(areas[1]):pick(a,/availability|preferred.*time|schedule/);var body=['Hi Ryan,','','I am reaching out through the Behavioral Bridge website.','','Parent / Contact: '+[first,last].filter(Boolean).join(' '),'My email: '+email,'Phone: '+phone,'Student: '+student,'Grade: '+grade,'Service requested: '+service,'','Goals / Help Requested:',goals||'','','General Availability:',availability||''].join('\\n');return 'mailto:Ryan_Carvalho@BehavioralBridge.org?subject='+encodeURIComponent('Behavioral Bridge Consultation Request')+'&body='+encodeURIComponent(body)}\n  function install(){bbSyncBanner();if(!bbIsConsult())return;var r=root();if(!r)return;var buttons=Array.from(r.querySelectorAll('button,input[type=submit]')).filter(function(x){return x.offsetParent!==null}),b=buttons.find(function(x){return x.type==='submit'||/request|consult|submit|send/i.test(x.textContent||x.value||'')})||buttons[buttons.length-1];if(!b||b.dataset.bbEmailOnly==='1')return;b.dataset.bbEmailOnly='1';if(b.tagName==='INPUT')b.value='EMAIL RYAN THIS REQUEST →';else b.textContent='EMAIL RYAN THIS REQUEST →';b.style.cssText+=';min-height:58px;font-weight:800;letter-spacing:.02em';var note=document.createElement('div');note.setAttribute('data-bb-email-note','1');note.style.cssText='margin:12px 0 10px;padding:12px 14px;border-radius:10px;background:#f5f1e7;border:1px solid #d7c496;font:600 13px/1.45 Arial,Helvetica,sans-serif;color:#312b20';note.textContent='Temporary delivery safeguard: this button opens your email app with the information above prepared. Please press Send in your email app to complete your request.';b.parentNode&&b.parentNode.insertBefore(note,b);b.addEventListener('click',function(e){e.preventDefault();e.stopPropagation();e.stopImmediatePropagation();location.href=buildMail(r)},true);var f=b.closest('form');if(f)f.addEventListener('submit',function(e){e.preventDefault();e.stopPropagation();e.stopImmediatePropagation();location.href=buildMail(r)},true)}\n  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',install,{once:true});else install();\n  new MutationObserver(install).observe(document.documentElement,{childList:true,subtree:true});\n  setTimeout(install,500);setTimeout(install,1500);\n})();</script><script id=\"bb-consultation-fields-v1\">(function(){\n  if(window.__BB_CONSULTATION_FIELDS_V1__) return;\n  window.__BB_CONSULTATION_FIELDS_V1__=true;\n  function visible(x){return x && x.offsetParent!==null}\n  function controls(r){return Array.from((r||document).querySelectorAll(\"input,textarea,select\")).filter(function(x){return ![\"hidden\",\"submit\",\"button\"].includes(x.type)})}\n  function desc(x){return [x&&x.name,x&&x.id,x&&x.placeholder,x&&x.getAttribute&&x.getAttribute(\"aria-label\")].filter(Boolean).join(\" \").toLowerCase()}\n  function root(){\n    var em=Array.from(document.querySelectorAll(\"input[type=email],input[name*=email i],input[id*=email i]\")).find(visible);\n    if(!em) return null;\n    var n=em;\n    for(var i=0;n&&i<20;i++,n=n.parentElement){\n      if(controls(n).length>=3 && n.querySelector(\"button,input[type=submit]\")) return n\n    }\n    return em.closest(\"form\")\n  }\n  function button(r){\n    return Array.from(r.querySelectorAll(\"button,input[type=submit]\")).filter(visible).find(function(x){return x.type===\"submit\"||/request|consult|submit|send/i.test(x.textContent||x.value||\"\")}) ||\n      Array.from(r.querySelectorAll(\"button,input[type=submit]\")).filter(visible).pop()\n  }\n  function has(r,key){return !!r.querySelector('[data-bb-field=\"'+key+'\"]')}\n  function make(r,key,label,type,placeholder){\n    if(has(r,key)) return;\n    var b=button(r);\n    if(!b || !b.parentNode) return;\n    var w=document.createElement(\"div\");\n    w.setAttribute(\"data-bb-field-wrap\",key);\n    w.style.cssText=\"margin:0 0 14px;width:100%;\";\n    var l=document.createElement(\"label\");\n    l.htmlFor=\"bb-\"+key;\n    l.textContent=label;\n    l.style.cssText=\"display:block;margin:0 0 6px;font:600 14px/1.35 Arial,Helvetica,sans-serif;color:#15171a;\";\n    var el=document.createElement(type===\"textarea\"?\"textarea\":type===\"select\"?\"select\":\"input\");\n    el.id=\"bb-\"+key;\n    el.name=key;\n    el.setAttribute(\"data-bb-field\",key);\n    el.setAttribute(\"aria-label\",label);\n    el.placeholder=placeholder||\"\";\n    el.style.cssText=\"box-sizing:border-box;width:100%;min-height:48px;padding:12px 14px;border:1px solid #c